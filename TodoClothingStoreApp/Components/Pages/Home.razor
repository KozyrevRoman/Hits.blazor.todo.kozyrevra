@page "/"
@rendermode InteractiveServer
@using TodoClothingStoreApp.Models
@using TodoClothingStoreApp.Services
@inject StoreService Store

<PageTitle>Магазин одежды</PageTitle>

<div class="p-4 mb-4 bg-dark text-white rounded-3 shadow-sm">
    <div class="container-fluid py-1">
        <h1 class="display-6 fw-bold">Магазин современной одежды</h1>
        <p class="col-md-8 fs-5 text-light mb-0">Выбирайте актуальные модели, фильтруйте по категориям и оформляйте заказ в один клик.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-5">
        <input type="text" class="form-control form-control-lg" placeholder="Поиск одежды по названию..." @bind="searchQuery" @bind:event="oninput" />
    </div>
    <div class="col-md-3">
        <select class="form-select form-select-lg" @bind="selectedCategoryId">
            <option value="0">Все категории</option>
            @foreach (var cat in categories)
            {
                <option value="@cat.Id">@cat.Name</option>
            }
        </select>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @if (!FilteredProducts.Any())
        {
            <div class="alert alert-info">По вашему запросу ничего не найдено.</div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-md-2 g-3">
                @foreach (var product in FilteredProducts)
                {
                    <div class="col">
                        <div class="card h-100 shadow-sm border-0">
                            <div class="card-body d-flex flex-column">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <span class="badge bg-secondary">@product.Category?.Name</span>
                                    <span class="badge bg-light text-dark border">Размер: @product.Size</span>
                                </div>
                                <h5 class="card-title mb-3">@product.Name</h5>
                                <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                                    <span class="fs-5 fw-bold text-primary">@product.Price.ToString("N0") ₽</span>
                                    <button class="btn btn-primary" @onclick="() => Store.AddToCart(product)">В корзину</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm border-0 sticky-top" style="top: 1rem;">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">Корзина</h5>
                <span class="badge bg-light text-primary rounded-pill">@Store.Cart.Sum(x => x.Quantity) шт.</span>
            </div>
            <div class="card-body">
                @if (!Store.Cart.Any())
                {
                    <p class="text-muted text-center my-4">В корзине пока пусто. Добавьте вещи из каталога.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-3">
                        @foreach (var item in Store.Cart)
                        {
                            <li class="list-group-item px-0 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-semibold">@item.Product.Name</div>
                                    <small class="text-muted">Размер: @item.Product.Size • @item.Quantity × @item.Product.Price.ToString("N0") ₽</small>
                                </div>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => Store.RemoveFromCart(item.Product.Id)">Удалить</button>
                            </li>
                        }
                    </ul>

                    <div class="d-flex justify-content-between align-items-center mb-3 pt-2 border-top">
                        <span class="fs-5">Итого:</span>
                        <span class="fs-4 fw-bold text-success">@Store.Cart.Sum(i => i.Product.Price * i.Quantity).ToString("N0") ₽</span>
                    </div>

                    <EditForm Model="checkoutModel" OnValidSubmit="PlaceOrder">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <InputText class="form-control" placeholder="Ваше имя для заказа" @bind-Value="checkoutModel.CustomerName" />
                            <ValidationMessage For="@(() => checkoutModel.CustomerName)" class="text-danger small" />
                        </div>
                        <button type="submit" class="btn btn-success btn-lg w-100">Оформить заказ</button>
                    </EditForm>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<Product> products = new();
    private List<Category> categories = new();
    private string searchQuery = "";
    private int selectedCategoryId = 0;
    private CheckoutFormModel checkoutModel = new();

    protected override async Task OnInitializedAsync()
    {
        categories = await Store.GetCategoriesAsync();
        products = await Store.GetProductsAsync();
    }

    private IEnumerable<Product> FilteredProducts => products
        .Where(p => selectedCategoryId == 0 || p.CategoryId == selectedCategoryId)
        .Where(p => string.IsNullOrWhiteSpace(searchQuery) || p.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase));

    private async Task PlaceOrder()
    {
        await Store.CheckoutAsync(checkoutModel.CustomerName);
        checkoutModel = new();
    }
}
